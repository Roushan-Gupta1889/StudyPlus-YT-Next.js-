// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  isIITMUser    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  videos        Video[]
  notes         Note[]
  playlists     Playlist[]
  watchHistory  WatchHistory[]
  analytics     UserAnalytics?
  preferences   UserPreferences?
  iitmProgress    IITMUserProgress[]
  contributions   Contributor[]

  @@map("users")
}

model Contributor {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  amount      Int
  message     String?  @db.Text
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([amount])
  @@index([createdAt])
  @@map("contributors")
}

model Video {
  id          String   @id @default(cuid())
  userId      String
  youtubeId   String
  title       String
  description String?
  thumbnail   String?
  duration    Int? // in seconds
  channel     String?
  progress    Int      @default(0) // percentage 0-100
  completed   Boolean  @default(false)
  inLibrary   Boolean  @default(true)
  
  // Player state persistence (Phase 1)
  currentTime   Int   @default(0)      // Last playback position in seconds
  playbackRate  Float @default(1.0)    // Playback speed (0.25, 0.5, 1.0, 1.5, 2.0)
  muted         Boolean @default(false) // Mute state
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes           Note[]
  watchHistory    WatchHistory[]
  playlistVideos  PlaylistVideo[]

  @@unique([userId, youtubeId])
  @@index([userId])
  @@index([userId, completed])
  @@index([userId, inLibrary])
  @@index([userId, progress])
  @@map("videos")
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  content     String   @db.Text
  timestamp   Int // in seconds
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([videoId])
  @@index([userId, videoId, createdAt])
  @@map("notes")
}

model Playlist {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos PlaylistVideo[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistVideo {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId])
  @@map("playlist_videos")
}

model WatchHistory {
  id         String   @id @default(cuid())
  userId     String
  videoId    String
  watchedAt  DateTime @updatedAt
  watchTime  Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@index([userId, watchedAt])
  @@map("watch_history")
}

model UserAnalytics {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalWatchTime  Int      @default(0) // in seconds
  videosCompleted Int      @default(0)
  currentStreak   Int      @default(0) // in days
  longestStreak   Int      @default(0)
  lastWatchDate   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_analytics")
}

model VideoSearch {
  id          String   @id @default(cuid())
  query       String
  type        String   @default("video") // video, channel, playlist
  results     Json     // Store search results as JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime // Cache expiration (24 hours)

  @@unique([query, type])
  @@index([query])
  @@index([expiresAt])
  @@map("video_searches")
}

model UserPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  dailyReminders Boolean  @default(true)
  weeklyReports  Boolean  @default(true)
  newFeatures    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ============================================
// IITM BS Curriculum Models
// ============================================

// Top-level curriculum sections (Foundation, Diploma, BSc, BS, etc.)
model IITMCurriculumSection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  order       Int
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories IITMCourseCategory[]

  @@map("iitm_curriculum_sections")
}

// Categories within sections (Core, Electives, Projects, etc.)
model IITMCourseCategory {
  id          String   @id @default(cuid())
  sectionId   String
  slug        String
  title       String
  description String?  @db.Text
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section IITMCurriculumSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courses IITMCourse[]

  @@unique([sectionId, slug])
  @@index([sectionId])
  @@map("iitm_course_categories")
}

// Individual IITM courses/playlists
model IITMCourse {
  id                String   @id @default(cuid())
  categoryId        String
  slug              String   @unique
  title             String
  description       String?  @db.Text
  courseCode        String?  // Official IITM course code (e.g., BSMA1001)
  youtubePlaylistId String
  thumbnail         String?
  lessonsCount      Int      @default(0)
  duration          Int?     // Total duration in seconds (optional)
  order             Int
  level             String?  // "beginner", "intermediate", "advanced"
  credits           Int?     // Course credits (e.g., 4)
  isProject         Boolean  @default(false) // True for project courses
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category     IITMCourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userProgress IITMUserProgress[]

  @@index([categoryId])
  @@map("iitm_courses")
}

// Track individual user progress on IITM courses
model IITMUserProgress {
  id             String    @id @default(cuid())
  userId         String
  courseId       String
  videosWatched  Int       @default(0)
  totalVideos    Int       @default(0)
  completionRate Int       @default(0) // 0-100
  lastWatchedAt  DateTime?
  isStarted      Boolean   @default(false)
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course IITMCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("iitm_user_progress")
}
