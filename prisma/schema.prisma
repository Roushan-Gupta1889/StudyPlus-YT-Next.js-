generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String             @unique
  emailVerified DateTime?
  image         String?
  password      String?
  isIITMUser    Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  role          Role               @default(USER)
  contributions Contributor[]
  iitmProgress  IITMUserProgress[]
  notes         Note[]
  playlists     Playlist[]
  analytics     UserAnalytics?
  preferences   UserPreferences?
  videos        Video[]
  watchHistory  WatchHistory[]

  @@map("users")
}

model Contributor {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  amount      Int
  message     String?
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])

  @@index([amount])
  @@index([createdAt])
  @@map("contributors")
}

model Video {
  id             String          @id @default(cuid())
  userId         String
  youtubeId      String
  title          String
  description    String?
  thumbnail      String?
  duration       Int?
  channel        String?
  progress       Int             @default(0)
  completed      Boolean         @default(false)
  inLibrary      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  currentTime    Int             @default(0)
  muted          Boolean         @default(false)
  playbackRate   Float           @default(1.0)
  notes          Note[]
  playlistVideos PlaylistVideo[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchHistory   WatchHistory[]

  @@unique([userId, youtubeId])
  @@index([userId])
  @@index([userId, completed])
  @@index([userId, inLibrary])
  @@index([userId, progress])
  @@map("videos")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  content   String
  timestamp Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([videoId])
  @@index([userId, videoId, createdAt])
  @@map("notes")
}

model Playlist {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  isIITM      Boolean         @default(false)
  videos      PlaylistVideo[]
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("playlists")
}

model PlaylistVideo {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId])
  @@map("playlist_videos")
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  watchedAt DateTime @default(now()) @updatedAt
  watchTime Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@index([userId, watchedAt])
  @@map("watch_history")
}

model UserAnalytics {
  id              String    @id @default(cuid())
  userId          String    @unique
  totalWatchTime  Int       @default(0)
  videosCompleted Int       @default(0)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastWatchDate   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_analytics")
}

model VideoSearch {
  id        String   @id @default(cuid())
  query     String
  type      String   @default("video")
  results   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@unique([query, type])
  @@index([query])
  @@index([expiresAt])
  @@map("video_searches")
}

model UserPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  dailyReminders Boolean  @default(true)
  weeklyReports  Boolean  @default(true)
  newFeatures    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model IITMCurriculumSection {
  id          String               @id @default(cuid())
  slug        String               @unique
  title       String
  description String?
  order       Int
  icon        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  categories  IITMCourseCategory[]

  @@map("iitm_curriculum_sections")
}

model IITMCourseCategory {
  id          String                @id @default(cuid())
  sectionId   String
  slug        String
  title       String
  description String?
  order       Int
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  section     IITMCurriculumSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courses     IITMCourse[]

  @@unique([sectionId, slug])
  @@index([sectionId])
  @@map("iitm_course_categories")
}

model IITMCourse {
  id                String             @id @default(cuid())
  categoryId        String
  slug              String             @unique
  title             String
  description       String?
  youtubePlaylistId String
  thumbnail         String?
  lessonsCount      Int                @default(0)
  duration          Int?
  order             Int
  level             String?
  credits           Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courseCode        String?
  isProject         Boolean            @default(false)
  category          IITMCourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userProgress      IITMUserProgress[]

  @@index([categoryId])
  @@map("iitm_courses")
}

model IITMUserProgress {
  id             String     @id @default(cuid())
  userId         String
  courseId       String
  videosWatched  Int        @default(0)
  totalVideos    Int        @default(0)
  completionRate Int        @default(0)
  lastWatchedAt  DateTime?
  isStarted      Boolean    @default(false)
  isCompleted    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  course         IITMCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("iitm_user_progress")
}

enum Role {
  USER
  ADMIN
}
